-allow-natives-syntax src/index.bench.ts","build":"rollup -c"},"version":"1.1.1","_npmUser":{"name":"GitHub Actions","email":"npm-oidc-no-reply@github.com","trustedPublisher":{"id":"github","oidcConfigId":"0a2a4a16-c491-4d24-9c9a-e2e70a4b7b28"}},"homepage":"https://github.com/D-Sketon/fast-archy#readme","keywords":["hierarchy","npm ls","unicode","pretty","print"],"repository":{"url":"git+https://github.com/D-Sketon/fast-archy.git","type":"git"},"_npmVersion":"11.19.0","description":"render nested hierarchies `npm ls` style with unicode pipes","directories":{},"maintainers":[{"name":"d-sketon","email":"2055272094@qq.com"}],"sideEffects":false,"_nodeVersion":"24.21.0","publishConfig":{"access":"public","provenance":true},"_hasShrinkwrap":false,"devDependencies":{"tsx":"^4.23.1","archy":"^1.0.0","tslib":"^2.8.1","mitata":"^1.0.34","rollup":"^4.62.2","vitest":"^4.1.10","typescript":"^5.9.3","@rollup/plugin-terser":"^1.0.0","@rollup/plugin-typescript":"^12.3.0"},"_npmOperationalInternal":{"host":"s3://npm-registry-packages-npm-production","tmp":"tmp/fast-archy_1.1.1_1792233173385_0.2550552172675913"},"_cnpmcore_publish_time":"2026-10-17T10:32:53.470Z","publish_time":1792233173470,"_source_registry_name":"default"}},"author":{"name":"D-Sketon"},"bugs":{"url":"https://github.com/D-Sketon/fast-archy/issues"},"description":"render nested hierarchies `npm ls` style with unicode pipes","homepage":"https://github.com/D-Sketon/fast-archy#readme","keywords":["hierarchy","npm ls","unicode","pretty","print"],"license":"MIT","maintainers":[{"name":"d-sketon","email":"2055272094@qq.com"}],"readme":"# fast-archy\n\n![npm bundle size](https://img.shields.io/bundlephobia/min/fast-archy) ![npm](https://img.shields.io/npm/v/fast-archy) ![NPM](https://img.shields.io/npm/l/fast-archy)\n\nRender nested hierarchies `npm ls` style with unicode pipes.\n\nRewrite of [archy](https://www.npmjs.com/package/archy) in TypeScript, making it faster.\n\n## Install\n\n```sh\nnpm install fast-archy\n```\n\n## Usage\n\n```js\nimport archy from \"fast-archy\";\n\nconst s = archy({\n  label: \"beep\\none\\ntwo\",\n  nodes: [\n    \"ity\",\n    {\n      label: \"boop\",\n      nodes: [\n        {\n          label: \"o_O\\nwheee\",\n          nodes: [\n            {\n              label: \"oh\",\n              nodes: [\"hello\", \"puny\\nmeat\"],\n            },\n            \"creature\",\n          ],\n        },\n        \"party\\ntime!\",\n      ],\n    },\n  ],\n});\n\nconsole.log(s);\n```\n\nOutput:\n\n```\nbeep\n│ one\n│ two\n├── ity\n└─┬ boop\n  ├─┬ o_O\n  │ │ wheee\n  │ ├─┬ oh\n  │ │ ├── hello\n  │ │ └── puny\n  │ │     meat\n  │ └── creature\n  └── party\n      time!\n```\n\n## API\n\n### archy(obj, prefix?, opts?)\n\n- `obj` `object|string` - Tree object or string label.\n  - `obj.label` `string` - Node label.\n  - `obj.nodes` `array` - Array of child nodes (same structure as `obj`).\n- `prefix` `string` - Custom prefix for tree branches (default: `\"\"`).\n- `opts` `object` - Options object.\n  - `opts.unicode` `boolean` - Use Unicode characters (default: `true`). If `false`, uses ASCII characters.\n\n## Benchmarks\n\n```\nclk: ~4.00 GHz\ncpu: 13th Gen Intel(R) Core(TM) i5-13400F\nruntime: node 26.5.0 (x64-win32)\n\nbenchmark                   avg (min … max) p75 / p99    (min … top 1%)\n------------------------------------------- -------------------------------\n• archy - simple tree\n------------------------------------------- -------------------------------\nfast-archy                    59.71 ns/iter  62.79 ns 107.23 ns █▆▅▂▂▁▁▁▁▁▁\narchy                        448.96 ns/iter 451.76 ns 626.10 ns ▆█▄▂▁▁▁▁▁▁▁\n\nsummary\n  fast-archy\n   7.52x faster than archy\n\n• archy - medium tree\n------------------------------------------- -------------------------------\nfast-archy                   271.60 ns/iter 274.68 ns 383.20 ns ▂█▇▃▂▂▁▁▁▁▁\narchy                          2.69 µs/iter   2.75 µs   2.90 µs ▂▂▂▄▆██▅▃▁▂\n\nsummary\n  fast-archy\n   9.92x faster than archy\n\n• archy - complex tree\n------------------------------------------- -------------------------------\nfast-archy                   431.70 µs/iter 443.60 µs 602.40 µs ██▃▃▂▁▁▁▁▁▁\narchy                          1.26 ms/iter   1.27 ms   1.67 ms ▁▂█▄▂▂▁▁▁▁▁\n\nsummary\n  fast-archy\n   2.91x faster than archy\n\n• archy - ascii mode\n------------------------------------------- -------------------------------\nfast-archy (ascii)           267.55 ns/iter 271.22 ns 374.34 ns ▃█▆▃▂▁▁▁▁▁▁\narchy (ascii)                  3.03 µs/iter   3.08 µs   3.24 µs ▃▃▄██▇▆▃▁▁▂\n\nsummary\n  fast-archy (ascii)\n   11.32x faster than archy (ascii)\n\n• archy - beepHexo\n------------------------------------------- -------------------------------\nfast-archy                   866.10 µs/iter 893.00 µs   1.13 ms ▅██▇▃▂▁▁▁▁▁\narchy                          9.81 ms/iter   9.95 ms  10.53 ms ▂▃▆█▇▇▄▃▂▂▁\n\nsummary\n  fast-archy\n   11.33x faster than archy\n```\n\n## License\n\nMIT\n","repository":{"url":"git+https://github.com/D-Sketon/fast-archy.git","type":"git"},"_source_registry_name":"default"}